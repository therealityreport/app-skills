{
  "chrome_health": {
    "profile": "Codex",
    "includeAdapters": true,
    "includeRepairHints": true
  },
  "chrome_targets": {
    "profile": "Codex",
    "query": "localhost",
    "limit": 10,
    "includeInactive": false
  },
  "tab_snapshot": {
    "target": "active",
    "profile": "Codex",
    "include": ["console", "network", "dom", "screenshot"],
    "dryRun": true
  },
  "debug_bundle_create": {
    "target": "active",
    "source": "dry-run",
    "include": ["console", "network", "timeline", "fingerprints"],
    "redact": true,
    "maxItems": 200
  },
  "debug_bundle_read": {
    "bundle": "test/fixtures/debug-run/basic",
    "section": "summary",
    "limit": 50
  },
  "debug_bundle_redact": {
    "bundle": "test/fixtures/redaction/sensitive",
    "policy": "default",
    "write": false
  },
  "api_calls_collect": {
    "target": "active",
    "source": "dry-run",
    "includeCurl": true,
    "limit": 100
  },
  "api_call_to_curl": {
    "run": "test/fixtures/debug-run/basic",
    "apiCall": "api-call-1",
    "shell": "posix"
  },
  "api_response_read": {
    "run": "test/fixtures/debug-run/basic",
    "apiCall": "api-call-1",
    "includeBody": false,
    "maxBodyBytes": 0
  },
  "debug_run_compare": {
    "baseline": "test/fixtures/debug-run/failing",
    "candidate": "test/fixtures/debug-run/fixed",
    "include": ["api", "console", "screenshot"],
    "format": "summary"
  },
  "context7_doctor": {
    "library": "chrome-devtools-protocol",
    "includeSchemaDrift": true,
    "strict": false
  },
  "upstream_mcp_doctor": {
    "strict": false,
    "expectedVersion": "1.2.0",
    "includeCategories": true
  },
  "list_network_requests": {
    "routeToken": "route_demo",
    "pageId": "page_1",
    "dryRun": true
  },
  "get_network_request": {
    "routeToken": "route_demo",
    "pageId": "page_1",
    "requestId": "request_1",
    "dryRun": true
  },
  "list_console_messages": {
    "routeToken": "route_demo",
    "pageId": "page_1",
    "dryRun": true
  },
  "take_snapshot": {
    "routeToken": "route_demo",
    "pageId": "page_1",
    "dryRun": true
  },
  "take_screenshot": {
    "routeToken": "route_demo",
    "pageId": "page_1",
    "dryRun": true
