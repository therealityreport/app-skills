{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "debug_bundle_redact.schema.json",
  "title": "debug_bundle_redact input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "bundle": {
      "type": "string",
      "minLength": 1
    },
    "policy": {
      "type": "string",
      "enum": ["default", "strict"],
      "default": "default"
    },
    "write": {
      "type": "boolean",
      "default": false,
      "description": "When false, return a redaction preview only."
    }
  },
  "required": ["bundle"]
}
