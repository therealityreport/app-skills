{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api_calls_collect.schema.json",
  "title": "api_calls_collect input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "target": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "enum": ["fixture", "dry-run"],
      "default": "dry-run"
    },
    "includeCurl": {
      "type": "boolean",
      "default": false
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500,
      "default": 100
    }
  },
  "required": ["target"]
}
