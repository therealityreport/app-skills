# Envato browser session.
# Run `npm run login` once to create this file without storing your password.
# Default: ~/.envato-r2/storage-state.json
ENVATO_STORAGE_STATE=
# Default: ~/.envato-r2/browser-profile
ENVATO_PROFILE_DIR=
# Default: ~/.envato-r2/downloads
ENVATO_DOWNLOAD_DIR=
ENVATO_HEADLESS=1
ENVATO_DEFAULT_PROJECT=

# Cloudflare R2 S3-compatible credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=envato
R2_REGION=auto
R2_PUBLIC_BASE_URL=

# Optional override when Chrome is not in the default macOS location.
CHROME_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
